\begin_layout Standard
De manera general, diremos que una cadena es 
\emph on
aceptada
\emph default
 por un AFN si existe al menos una trayectoria de ejecución que termina
 en un estado final y diremos que es 
\emph on
rechazada
\emph default
 cuando todas las posibles trayectorias de ejecución se estancan (mueren)
 o terminan en un estado que no es final.
 Finalmente, mostramos la función de transición extendida 
\begin_inset Formula $\hat{\delta}$
\end_inset

 como sigue:
\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Definition

\emph on
(Función de Transición Extendida) La función de transición extendida, 
\begin_inset Formula $\hat{\delta}:Q\times\Sigma^{*}\rightarrow\mathcal{P}(Q)$
\end_inset

, se define inductivamente en términos de 
\begin_inset Formula $\delta$
\end_inset

 como sigue.
 Sea 
\begin_inset Formula $q\in Q,a\in\Sigma$
\end_inset

 y 
\begin_inset Formula $x\in\Sigma^{*}$
\end_inset

, entonces:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
\hat{\delta}\left(q,\varepsilon\right) & \rightarrow & \left\{ q\right\} \\
\hat{\delta}\left(q,xa\right) & \rightarrow & \underset{p_{i}\in\hat{\delta}(q,x)}{\text{\ensuremath{\bigcup}}}\delta\left(p_{i},a\right)
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard
Por ejemplo, podemos usar 
\begin_inset Formula $\hat{\delta}$
\end_inset

 para describir el procesamiento de la entrada 00101 por el AFN de nuestro
 ejemplo anterior.
 
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\hat{\delta}\left(q_{0},\varepsilon\right)=\left\{ q_{0}\right\} $
\end_inset


\end_layout

\begin_layout Enumerate
\begin_inset Formula $\hat{\delta}\left(q_{0},0\right)=\delta\left(q_{0},0\right)=\left\{ q_{0},q_{1}\right\} $
\end_inset


\end_layout

\begin_layout Enumerate
\begin_inset Formula $\hat{\delta}\left(q_{0},00\right)=\delta\left(q_{0},0\right)\cup\delta\left(q_{1},0\right)=\left\{ q_{0},q_{1}\right\} \cup\varnothing=\left\{ q_{0},q_{1}\right\} $
\end_inset


\end_layout

\begin_layout Enumerate
\begin_inset Formula $\hat{\hat{\delta}\left(q_{0},001\right)=\delta\left(q_{0},1\right)\cup\delta\left(q_{1},1\right)=\left\{ q_{0}\right\} \cup\left\{ q_{2}\right\} =\left\{ q_{0},q_{2}\right\} }$
\end_inset


\end_layout

\begin_layout Enumerate
\begin_inset Formula $\hat{\delta}\left(q_{0},0010\right)=\delta\left(q_{0},0\right)\cup\delta\left(q_{2},0\right)=\left\{ q_{0},q_{1}\right\} \cup\varnothing=\left\{ q_{0},q_{1}\right\} $
\end_inset


\end_layout

\begin_layout Enumerate
\begin_inset Formula $\hat{\delta}\left(q_{0},00101\right)=\delta\left(q_{0},1\right)\cup\delta\left(q_{1},1\right)=\left\{ q_{0}\right\} \cup\left\{ q_{2}\right\} =\left\{ q_{0},q_{2}\right\} $
\end_inset


\end_layout

\begin_layout Standard
Finalmente, decimos que el lenguaje de un AFN 
\begin_inset Formula $N=\left\langle Q,\Sigma,\delta,q_{0},F\right\rangle $
\end_inset

 denotado por 
\begin_inset Formula $L\left(N\right)$
\end_inset

 se define como:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
L\left(N\right)=\left\{ w\in\Sigma^{*}:\hat{\delta}\left(q_{0},w\right)\cap F\neq\varnothing\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard
Es decir, son todas las cadenas que procesadas por el autómata desde el
 estado inicial, llegan por alguna trayectoria a algún estado final.
 
\end_layout

