\begin_layout Paragraph
Definición Recursiva para Árboles Binarios
\end_layout

\begin_layout Standard
Para definir una función 
\begin_inset Formula $h:\mathbb{\texttt{{ArbolB}}}\rightarrow A$
\end_inset

, basta definir 
\begin_inset Formula $h$
\end_inset

 como sigue:
\end_layout

\begin_layout Itemize
Definir 
\begin_inset Formula $h$
\end_inset

 para el árbol vacío.
 
\end_layout

\begin_layout Itemize
Suponiendo definida 
\begin_inset Formula $h\left(T_{1}\right)$
\end_inset

 y 
\begin_inset Formula $h\left(T_{2}\right)$
\end_inset

, definir a partir de ésta a 
\begin_inset Formula $h\left(tree\left(T_{1},a,T_{2}\right)\right)$
\end_inset

.
\end_layout

\begin_layout Standard
Veamos algunos ejemplos.
\end_layout

