\begin_layout Definition
(
\emph on
Árboles Binarios) Los Árboles Binarios con elementos en un conjunto A, se
 definen recursivamente como:
\end_layout

\begin_layout Itemize

\emph on
Un árbol vacío es un Árbol Binario, se denota por 
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
texttt{void}
\end_layout

\end_inset

.
\end_layout

\begin_layout Itemize

\emph on
Si 
\begin_inset ERT
status open

\begin_layout Plain Layout

$T_1$
\end_layout

\end_inset

 y 
\begin_inset ERT
status open

\begin_layout Plain Layout

$T_2$
\end_layout

\end_inset

 son árboles binarios y 
\begin_inset ERT
status open

\begin_layout Plain Layout

$a 
\backslash
in A$
\end_layout

\end_inset

, entonces 
\begin_inset ERT
status open

\begin_layout Plain Layout

$tree(T_1,a,T_2)$
\end_layout

\end_inset

 es un Árbol Binario, donde 
\begin_inset ERT
status open

\begin_layout Plain Layout

$T_1$
\end_layout

\end_inset

 es el subárbol izquierdo y 
\begin_inset ERT
status open

\begin_layout Plain Layout

$T_2$
\end_layout

\end_inset

 es el subárbol derecho.
 Al nodo etiquedado con 
\begin_inset ERT
status open

\begin_layout Plain Layout

$a$
\end_layout

\end_inset

 se le llama la raíz del árbol.
\end_layout

