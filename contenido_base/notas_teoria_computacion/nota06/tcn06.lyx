\end_inset

 ALC
\begin_inset Formula $_{i}\cup\left\{ A\in V:\exists\text{ producción }B\rightarrow uAv,B\in ALC_{i}\;u,v\in\left(V\cup\Sigma\right)^{*}\right\} $
\end_inset

.
\end_layout

\begin_layout Standard
De esta forma obtenemos una sucesión creciente de conjuntos de variables:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
ALC_{1}\subseteq ALC_{2}\subseteq ALC_{3}\subseteq...
\]

\end_inset


\end_layout

\begin_layout Standard
El algoritmo se presenta entonces como:
\end_layout

\begin_layout Itemize
Inicializar: 
\series bold
ALC 
\begin_inset Formula $:=\left\{ S\right\} $
\end_inset

.
\end_layout

\begin_layout Itemize
Repetir: 
\series bold
ALC
\series default
 
\series bold

\begin_inset Formula $:=$
\end_inset

 ALC 
\begin_inset Formula $\cup\left\{ A\in V:\exists\text{ producción }B\rightarrow uAv,B\in ALC\;u,v\in\left(V\cup\Sigma\right)^{*}\right\} $
\end_inset

..
\end_layout

\begin_layout Itemize
Hasta: No se añaden nuevas variables a 
\series bold
ALC.
\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Example
Encontrar las variables terminales de la siguiente gramática
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
S & \rightarrow & aS\;|\;AaB\;|\;ACS\\
A & \rightarrow & aS\;|\;AaB\;|\;AC\\
B & \rightarrow & bB\;|\;DB\;|\:BB\\
C & \rightarrow & aDa\;|\;ABD\;|\;ab\\
D & \rightarrow & aD\;|\;DD\;|\;ab\\
E & \rightarrow & FF\;|\;aa\\
F & \rightarrow & aE\;|\;EF
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard

\emph on
Solución
\end_layout

\begin_layout Standard

\series bold
ALC
\begin_inset Formula $_{1}=\left\{ S\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

ALC
\begin_inset Formula $_{2}=\left\{ S\right\} \cup\left\{ A,B,C\right\} =\left\{ S,A,B,C\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

ALC
\begin_inset Formula $_{3}=\left\{ S,A,B,C\right\} \cup\left\{ D\right\} =\left\{ S,A,B,C,D\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

ALC
\begin_inset Formula $_{4}=\left\{ S,A,B,C,D\right\} \cup\varnothing=\left\{ S,A,B,C,D\right\} $
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\therefore$
\end_inset

 El conjunto de variables no alcanzables es 
\begin_inset Formula $\left\{ E,F\right\} $
\end_inset


\end_layout

\begin_layout Subsubsection
Eliminación de producciones 
\begin_inset Formula $\varepsilon$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Definition

\emph on
(Producción) Una producción de la forma 
\begin_inset Formula $A\rightarrow\varepsilon$
\end_inset

 se llama producción 
\begin_inset Formula $\varepsilon$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Definition

\emph on
(Variable anulable) Una variable A se llama anulable si 
\begin_inset Formula $A\Rightarrow^{*}\varepsilon$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard

\series bold
Algoritmo para encontrar las variables anulables
\end_layout

\begin_layout Standard
El siguiente algoritmo sirve para encontrar todas las variables alcanzables
 de una GLC.
\end_layout

\begin_layout Standard

\series bold
ANUL
\begin_inset Formula $_{1}:=\left\{ A\in V:A\rightarrow\varepsilon\text{ es una producción}\right\} $
\end_inset

.
\begin_inset Newline newline
\end_inset

ANUL
\begin_inset Formula $_{i+1}:=$
\end_inset

 ANUL
\begin_inset Formula $_{i}\cup\left\{ A\in V:\exists\text{ producción }A\rightarrow w,w\in\left(ANUL_{i}\right)^{*}\right\} $
\end_inset

.
\end_layout

\begin_layout Standard
De esta forma obtenemos una sucesión creciente de conjuntos de variables:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
ANUL_{1}\subseteq ANUL_{2}\subseteq ANUL_{3}\subseteq...
\]

\end_inset


\end_layout

\begin_layout Standard
El algoritmo se presenta entonces como:
\end_layout

\begin_layout Itemize
Inicializar: 
\series bold
ANUL 
\begin_inset Formula $:=\left\{ A\in V:A\rightarrow\varepsilon\text{ es una producción}\right\} $
\end_inset

.
\end_layout

\begin_layout Itemize
Repetir: 
\series bold
ANUL 
\begin_inset Formula $:=$
\end_inset

 ANUL
\series default
 
\series bold

\begin_inset Formula $\cup\left\{ A\in V:\exists\text{ producción }A\rightarrow w,w\in\left(ANUL\right)^{*}\right\} $
\end_inset

.
\end_layout

\begin_layout Itemize
Hasta: No se añaden nuevas variables a 
\series bold
ANUL.
\end_layout

\begin_layout Standard
Una vez que haya sido determinado el conjunto 
\series bold
ANUL
\series default
 de variables anulables, por medio del algoritmo anterior, las producciones
 
\begin_inset Formula $\varepsilon$
\end_inset

 se pueden eliminar (excepto 
\begin_inset Formula $S\rightarrow\varepsilon$
\end_inset

) añadiendo nuevas producciones que simulen el efecto de las producciones
 
\begin_inset Formula $\varepsilon$
\end_inset

 eliminadas.
 Más concretamente, por cada producción 
\begin_inset Formula $A\rightarrow u$
\end_inset

 se añaden producciones de la forma 
\begin_inset Formula $A\rightarrow v$
\end_inset

 obtenidas suprimiendo de la cadena 
\begin_inset Formula $u$
\end_inset

 una, dos o más variable anulables presentes de todas las formas posibles.
\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Example
Encontrar las producciones 
\begin_inset Formula $\varepsilon$
\end_inset

 de la siguiente gramática
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
S & \rightarrow & AB\;|\;ACA\;|\;ab\\
A & \rightarrow & aAa\;|\;B\;|\;CD\\
B & \rightarrow & bB\;|\;bA\\
C & \rightarrow & cC\;|\;\varepsilon\\
D & \rightarrow & aDc\;|\;CC\;|\;ABb
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard

\emph on
Solución
\end_layout

\begin_layout Standard

\series bold
ANUL
\begin_inset Formula $_{1}=\left\{ C\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

ANUL
\begin_inset Formula $_{2}=\left\{ C\right\} \cup\left\{ D\right\} =\left\{ C,D\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

ANUL
\begin_inset Formula $_{3}=\left\{ C,D\right\} \cup\left\{ A\right\} =\left\{ C,D,A\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

ANUL
\begin_inset Formula $_{4}=\left\{ C,D,A\right\} \cup\left\{ S\right\} =\left\{ C,D,A,S\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

ANUL
\begin_inset Formula $_{5}=\left\{ C,D,A,S\right\} \cup\varnothing=\left\{ C,D,A,S\right\} $
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\therefore$
\end_inset

 El conjunto de variables anulables es 
\begin_inset Formula $\left\{ C,D,A,S\right\} $
\end_inset

.
 Al eliminar las producciones 
\begin_inset Formula $\varepsilon$
\end_inset

, tenemos:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
S & \rightarrow & AB\;|\;ACA\;|\;ab\;|\;B\;|\;CA\;|\;AA\;|\;AC\;|\;A\;|\;C\;|\;\varepsilon\\
A & \rightarrow & aAa\;|\;B\;|\;CD\;|\;aa\;|\;C\;|\;D\\
B & \rightarrow & bB\;|\;bA\;|\;b\\
C & \rightarrow & cC\;|\;c\\
D & \rightarrow & aDc\;|\;CC\;|\;ABb\;|\;ac\;|\;C\;|\;Bb
\end{array}
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Eliminación de producciones unitarias
\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Definition

\emph on
(Producción unitaria) Una producción de la forma 
\begin_inset Formula $A\rightarrow B$
\end_inset

 donde 
\begin_inset Formula $A$
\end_inset

 y 
\begin_inset Formula $B$
\end_inset

 son variables, se llama producción unitaria.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Definition

\emph on
(Conjunto unitario) El conjunto unitario de una variable A se define de
 la siguiente manera:
\end_layout

\begin_layout Definition
\begin_inset Formula 
\[
UNIT(A):=\left\{ X\in V:\exists\text{ una derivación }A\Rightarrow^{*}X\text{ que usa únicamente producciones unitarias}\right\} 
\]

\end_inset


\end_layout

\begin_layout Definition
Por definición 
\begin_inset Formula $A\in UNIT\left(A\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard

\series bold
Algoritmo para encontrar las producciones unitarias
\end_layout

\begin_layout Standard
El siguiente algoritmo sirve para encontrar todas las variables alcanzables
 de una GLC.
\end_layout

\begin_layout Standard

\series bold
UNIT
\begin_inset Formula $_{1}(A):=\left\{ A\right\} $
\end_inset

.
\begin_inset Newline newline
\end_inset

UNIT
\begin_inset Formula $_{i+1}:=$
\end_inset

 UNIT
\begin_inset Formula $_{i}(A)\cup\left\{ X\in V:\exists\text{ producción }Y\rightarrow X,Y\in\left(UNIT_{i}(A)\right)\right\} $
\end_inset

.
\end_layout

\begin_layout Standard
De esta forma obtenemos una sucesión creciente de conjuntos de variables:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
UNIT_{1}\subseteq UNIT_{2}\subseteq UNIT_{3}\subseteq...
\]

\end_inset


\end_layout

\begin_layout Standard
El algoritmo se presenta entonces como:
\end_layout

\begin_layout Itemize
Inicializar: 
\series bold
UNIT
\begin_inset Formula $(A):=\left\{ A\right\} $
\end_inset

.
\end_layout

\begin_layout Itemize
Repetir: 
\series bold
UNIT
\begin_inset Formula $(A):=$
\end_inset

 UNIT
\begin_inset Formula $(A)\cup\left\{ X\in V:\exists\text{ producción }Y\rightarrow X,Y\in\left(UNIT(A)\right)\right\} $
\end_inset


\end_layout

\begin_layout Itemize
Hasta: No se añaden nuevas variables a 
\series bold
ANUL.
\end_layout

\begin_layout Standard
Las producciones unitarias se pueden eliminar añadiendo para cada variable
 
\begin_inset Formula $A$
\end_inset

 las producciones (no unitarias) de las variables contenidas en el conjunto
 unitario UNIT(A).
 
\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Example
Eliminar las producciones unitarias de la siguiente gramática:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
S & \rightarrow & AS\;|\;AA\;|\;BA\;|\;\varepsilon\\
A & \rightarrow & aA\;|\;a\\
B & \rightarrow & bB\;|\;bC\;|\;C\\
C & \rightarrow & aA\;|\;bA\;|\;B\;|ab
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard

\emph on
Solución
\end_layout

\begin_layout Standard

\series bold
UNIT(S)
\begin_inset Formula $_{1}=\left\{ S\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

UNIT(S)
\begin_inset Formula $_{2}=\left\{ S\right\} \cup\varnothing=\left\{ S\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

UNIT(A)
\begin_inset Formula $_{1}=\left\{ A\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

UNIT(A)
\begin_inset Formula $_{2}=\left\{ A\right\} \cup\varnothing=\left\{ A\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

UNIT(B)
\begin_inset Formula $_{1}=\left\{ B\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

UNIT(B)
\begin_inset Formula $_{2}=\left\{ B\right\} \cup\left\{ C\right\} =\left\{ B,C\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

UNIT(B)
\begin_inset Formula $_{3}=\left\{ B,C\right\} \cup\left\{ B\right\} =\left\{ B,C\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

UNIT(C)
\begin_inset Formula $_{1}=\left\{ C\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

UNIT(C)
\begin_inset Formula $_{2}=\left\{ C\right\} \cup\left\{ B\right\} =\left\{ C,B\right\} $
\end_inset


\begin_inset Newline newline
\end_inset

UNIT(C)
\begin_inset Formula $_{3}=\left\{ C,B\right\} \cup\left\{ C\right\} =\left\{ C,B\right\} $
\end_inset


\end_layout

\begin_layout Standard
Eliminando las producciones unitarias se obtiene:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
S & \rightarrow & AS\;|\;AA\;|\;BA\;|\;\varepsilon\\
A & \rightarrow & aA\;|\;a\\
B & \rightarrow & bB\;|\;bC\;|\;aA\;|\;bA\;|\;ab\\
C & \rightarrow & aA\;|\;bA\;|\;bB\;|\;bC\;|ab
\end{array}
\]

\end_inset


\end_layout

\begin_layout Subsection
Forma Normal de Chomsky (FNC)
\end_layout

\begin_layout Standard
Una GLC está en 
\emph on
Forma Normal de Chomsky (FNC) 
\emph default
si cumple con:
\end_layout

\begin_layout Enumerate
No tiene variables inútiles.
\end_layout

\begin_layout Enumerate
No tiene producciones 
\begin_inset Formula $\varepsilon$
\end_inset

 (exceptuando el posible caso de 
\begin_inset Formula $S\rightarrow\varepsilon$
\end_inset

)
\end_layout

\begin_layout Enumerate
Todas las producciones son de la forma 
\begin_inset Formula $A\rightarrow a$
\end_inset

 (producciones simples) o 
\begin_inset Formula $A\rightarrow BC$
\end_inset

 (producciones binarias).
\end_layout

\begin_layout Standard
En particular, una gramática FNC no tiene producciones unitarias.
\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Theorem
(Procedimiento de conversión a FNC) Toda GLC es equivalente a una gramática
 en Forma Normal de Chomsky.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard
Para transformar una GLC en FNC, seguiremos los algoritmos de la sección
 anterior en el siguiente orden:
\end_layout

\begin_layout Enumerate
Eliminar todas las variables no terminales.
\end_layout

\begin_layout Enumerate
Eliminar todas las variables no alcanzables.
\end_layout

\begin_layout Enumerate
Eliminar las producciones 
\begin_inset Formula $\varepsilon$
\end_inset

, exceptuando por supuesto el caso del símbolo inicial.
\end_layout

\begin_layout Enumerate
Eliminar las producciones unitarias.
\end_layout

\begin_layout Enumerate
Las producciones resultantes (que no sean 
\begin_inset Formula $S\rightarrow\varepsilon$
\end_inset

) son de la forma: 
\begin_inset Formula $A\rightarrow a$
\end_inset

 o 
\begin_inset Formula $A\rightarrow w$
\end_inset

, donde 
\begin_inset Formula $|w|\geq2$
\end_inset

.
 Estas últimas se pueden simular con producciones de la forma 
\begin_inset Formula $A\rightarrow BC$
\end_inset

 o 
\begin_inset Formula $A\rightarrow a$
\end_inset

.
 Se introduce primero, para cada 
\begin_inset Formula $a\in\Sigma$
\end_inset

, una variable nueva 
\begin_inset Formula $T_{a}$
\end_inset

 cuya única producción es 
\begin_inset Formula $T_{a}\rightarrow A$
\end_inset

.
 A continuación se introducen nuevas variables, con producciones binarias,
 para simular las producciones deseadas.
\end_layout

\begin_layout Standard
Dado que ya practicamos los pasos 1 al 4, ilustraremos un ejemplo del paso
 5.
\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Example
Simular la producción 
\begin_inset Formula $A\rightarrow abBaC$
\end_inset

 con producciones simples y binarias.
\end_layout

\begin_layout Example

\emph on
Solución:
\end_layout

\begin_layout Example
Introducimos las variables 
\begin_inset Formula $T_{a}$
\end_inset

 y 
\begin_inset Formula $T_{b}$
\end_inset

 y las producciones 
\begin_inset Formula $T_{a}\rightarrow a$
\end_inset

 y 
\begin_inset Formula $T_{b}\rightarrow b$
\end_inset

.
 Entonces 
\begin_inset Formula $A\rightarrow abBaC$
\end_inset

 se simula con:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
A & \rightarrow & T_{a}T_{b}BT_{a}C\\
T_{a} & \rightarrow & a\\
T_{b} & \rightarrow & b
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
Ahora introducimos nuevas variables 
\begin_inset Formula $T_{1},T_{2},T_{3}$
\end_inset

 y las producciones binarias necesarias.
 Las únicas producciones de estas nuevas variables son las siguientes:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
A & \rightarrow & T_{a}T_{1}\\
T_{1} & \rightarrow & T_{b}T_{2}\\
T_{2} & \rightarrow & BT_{3}\\
T_{3} & \rightarrow & T_{a}C\\
T_{a} & \rightarrow & a\\
T_{b} & \rightarrow & b
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Example
Encontrar una GLC en FNC equivalente a la siguiente gramática:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
S & \rightarrow & AB\;|\;aBC\;|\;SBS\\
A & \rightarrow & aA\;|\;C\\
B & \rightarrow & bbB\;|\;b\\
C & \rightarrow & cC\;|\;\varepsilon
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard

\emph on
Solución
\end_layout

\begin_layout Standard
El conjunto de variables terminales es:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
TERM=\left\{ B,C,S,A\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard
y el conjunto de variables alcanzables es:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
ALC=\left\{ S,A,B,C\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard
Es decir, la gramática no tiene variables inútiles.
 El conjunto de variables anulables es 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
ANUL=\left\{ C,A\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard
Al eliminar las producciones 
\begin_inset Formula $\varepsilon$
\end_inset

 de G se obtiene la gramática:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
S & \rightarrow & AB\;|\;aBC\;|\;SBS\;|\;B\;|\;aB\\
A & \rightarrow & aA\;|\;C\;|\;a\\
B & \rightarrow & bbB\;|\;b\\
C & \rightarrow & cC\;|\;c
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
A continuación encontramos los conjuntos unitarios de todas las variables:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
UNIT(S) & = & \left\{ S,B\right\} \\
UNIT(A) & = & \left\{ A,C\right\} \\
UNIT(B) & = & \left\{ B\right\} \\
UNIT\left(C\right) & = & \left\{ C\right\} 
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
Al eliminar las producciones unitarias, tenemos:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
S & \rightarrow & AB\;|\;aBC\;|\;SBS\;|\;bbB\;|\;b\;|\;aB\\
A & \rightarrow & aA\;|\;cC\;|\;c\;|\;a\\
B & \rightarrow & bbB\;|\;b\\
C & \rightarrow & cC\;|\;c
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
Luego introducimos las variables nuevas 
\begin_inset Formula $T_{a},T_{b}$
\end_inset

 y 
\begin_inset Formula $T_{c}$
\end_inset

 y las producciones 
\begin_inset Formula $T_{a}\rightarrow a,T_{b}\rightarrow b$
\end_inset

 y 
\begin_inset Formula $T_{c}\rightarrow c$
\end_inset

 con el propósito de que todas las producciones sean unitarias o de la forma
 
\begin_inset Formula $A\rightarrow w$
\end_inset

 con 
\begin_inset Formula $|w|\geq2$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
S & \rightarrow & AB\;|\;T_{a}BC\;|\;SBS\;|\;T_{b}T_{b}B\;|\;b\;|\;T_{a}B\\
A & \rightarrow & T_{a}A\;|\;T_{c}C\;|\;c\;|\;a\\
B & \rightarrow & T_{b}T_{b}B\;|\;b\\
C & \rightarrow & T_{c}C\;|\;c\\
T_{a} & \rightarrow & a\\
T_{b} & \rightarrow & b\\
T_{c} & \rightarrow & c
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
Finalmente, se introducen nuevas variables, con producciones binarias, para
 simular las producciones de la forma 
\begin_inset Formula $A\rightarrow w$
\end_inset

 con 
\begin_inset Formula $|w|\geq2$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{rcl}
S & \rightarrow & AB\;|\;T_{a}T_{1}\;|\;ST_{2}\;|\;T_{b}T_{3}\;|\;b\;|\;T_{a}B\\
A & \rightarrow & T_{a}A\;|\;T_{c}C\;|\;c\;|\;a\\
B & \rightarrow & T_{b}T_{3}\;|\;b\\
C & \rightarrow & T_{c}C\;|\;c\\
T_{a} & \rightarrow & a\\
T_{b} & \rightarrow & b\\
T_{c} & \rightarrow & c\\
T_{1} & \rightarrow & BC\\
T_{2} & \rightarrow & BS\\
T_{3} & \rightarrow & T_{b}B
\end{array}
\]

\end_inset


\end_layout

