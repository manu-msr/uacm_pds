\[
\begin{array}{rcl}
A & \rightarrow & aA\\
A & \rightarrow & bB\\
B & \rightarrow & aA\\
B & \rightarrow & bC\\
B & \rightarrow & b\\
C & \rightarrow & aC\\
C & \rightarrow & bC\\
C & \rightarrow & a\\
C & \rightarrow & b
\end{array}
\]

\end_inset


\end_layout

