\end_layout

\begin_layout Example
Podemos usar los símbolos no terminales para 
\emph on
recordar
\emph default
 situaciones.
 Es decir:
\end_layout

\begin_layout Itemize
Un símbolo 
\begin_inset Formula $A$
\end_inset

 que recuerda que aún no se ha producido ninguna 
\begin_inset Formula $b$
\end_inset

.
\end_layout

\begin_layout Itemize
Un símbolo 
\begin_inset Formula $B$
\end_inset

 que recuerda que se produjo una 
\begin_inset Formula $b$
\end_inset

.
\end_layout

\begin_layout Itemize
Un símbolo 
\begin_inset Formula $C$
\end_inset

 que recuerda que ya se produjeron las dos 
\begin_inset Formula $b$
\end_inset

.
\end_layout

\begin_layout Standard
